rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true; }
    match /listingPhotos/{uid}/{file} { allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024; allow read: if signedIn(); }
    match /agencyLogos/{uid}/{file} { allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; allow read: if signedIn(); }
    match /agencyVerification/{uid}/{file} { allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024; allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); }
  }
}
